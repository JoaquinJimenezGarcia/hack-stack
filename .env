# starter keeps the image smaller. For the full official headless tool set:
#   TOOLSET=kali-linux-headless
# Any other official kali-* metapackage name is also accepted.
TOOLSET=starter

# Ceilings, not reservations. Stopped containers use no CPU or RAM.
KALI_MEM_LIMIT=2g
KALI_CPUS=2
JUICE_MEM_LIMIT=512m

# Published on 127.0.0.1 only. Do not bind this to 0.0.0.0.
# Host port. 3000 is often already taken by another local app.
JUICE_PORT=3080
